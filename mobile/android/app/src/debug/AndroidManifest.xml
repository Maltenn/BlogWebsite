<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext HTTP, so a build can talk to the dev Worker at http://10.0.2.2:8787 (the emulator's
     name for the host machine). A release build has no such file and refuses cleartext (the Android 9+ default). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
