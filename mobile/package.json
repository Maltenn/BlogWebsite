{
  "name": "ourspace-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The OurSpace iOS and Android apps: a Capacitor shell around the unmodified ../public bundle. Separate from the root package.json on purpose. See docs/mobile/shells.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios --packagemanager CocoaPods",
    "assets": "node scripts/make-splash.mjs",
    "check": "node scripts/check.mjs",
    "check:release": "node scripts/check.mjs --release",
    "test": "node --test \"test/*.test.mjs\"",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "capacitor:copy:after": "node scripts/after-copy.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/action-sheet": "8.1.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fontsource/roboto": "5.2.8"
  }
}
